{
  "name": "buildtrack",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --config prisma7.config.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node --test tests/foundation.test.mjs tests/auth-foundation.test.mjs",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:auth-schema": "auth generate --adapter prisma --dialect postgresql --config src/server/auth/schema-blueprint.ts --output prisma/better-auth.generated.prisma",
    "db:auth-check": "node scripts/verify-auth-schema.mjs",
    "db:migrate:prepare": "node scripts/prepare-initial-migration.mjs",
    "db:migrate:apply": "node scripts/apply-initial-migration.mjs",
    "db:migrate:status": "prisma migrate status --config prisma7.config.ts",
    "db:check": "tsx scripts/db-check.ts",
    "check": "npm run test:smoke && npm run lint && npm run db:validate && npm run db:generate && npm run typecheck && npm run test && npm run build",
    "auth:bootstrap:dev": "tsx scripts/bootstrap-dev-owner.ts",
    "test:auth": "vitest run tests/auth"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1178.0",
    "@aws-sdk/s3-request-presigner": "3.1178.0",
    "@dnd-kit/core": "6.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.16",
    "dotenv": "^16.6.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nodemailer": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.3.0",
    "sharp": "0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "auth": "1.7.16",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
