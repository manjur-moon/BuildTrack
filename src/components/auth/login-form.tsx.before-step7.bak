"use client";
import { FormEvent, useState } from "react";
import Link from "next/link";
import { useRouter, useSearchParams } from "next/navigation";
import { authClient } from "@/lib/auth-client";

export function LoginForm() {
  const router = useRouter();
  const next = useSearchParams().get("next") ?? "";
  const redirectPath = next.startsWith("/accept-invitation?id=") && !next.startsWith("//") ? next : "/account";
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [message, setMessage] = useState("");
  const [loading, setLoading] = useState(false);
  async function submit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault(); setMessage(""); setLoading(true);
    try {
      const result = await authClient.signIn.email({ email, password, rememberMe: true });
      if (result.error) { setMessage("Unable to sign in. Check your credentials and verify your email."); return; }
      router.replace(redirectPath); router.refresh();
    } catch { setMessage("Unable to sign in. Please try again."); }
    finally { setLoading(false); }
  }
  return <form className="space-y-4" onSubmit={submit}>
    <div><label htmlFor="email" className="block text-sm font-medium">Email</label><input id="email" type="email" autoComplete="username" required className="w-full rounded border p-2" value={email} onChange={e => setEmail(e.target.value)} /></div>
    <div><label htmlFor="password" className="block text-sm font-medium">Password</label><input id="password" type="password" autoComplete="current-password" required className="w-full rounded border p-2" value={password} onChange={e => setPassword(e.target.value)} /></div>
    {message && <p role="alert" className="text-sm text-red-700">{message}</p>}
    <button disabled={loading} type="submit" className="rounded bg-neutral-900 px-4 py-2 text-white disabled:opacity-50">{loading ? "Signing in..." : "Sign in"}</button>
    <p className="text-sm"><Link href="/forgot-password" className="underline">Forgot password?</Link></p>
    <p className="text-sm">New team member? Use the invitation link sent to your email.</p>
  </form>;
}
