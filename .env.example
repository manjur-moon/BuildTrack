# Local development only. Never commit .env.
DATABASE_URL="postgresql://buildtrack_app:REPLACE_PASSWORD@localhost:5432/buildtrack?schema=public"
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="REPLACE_WITH_32_BYTE_RANDOM_SECRET"
BETTER_AUTH_URL="http://localhost:3000"
# For real invitation and verification delivery (Mailpit example)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_FROM="BuildTrack <no-reply@buildtrack.local>"
# Optional for SMTP servers requiring authentication
SMTP_USER=""
SMTP_PASSWORD=""
NODE_ENV="development"
# Only for scripts/bootstrap-dev-owner.ts in disposable dev DB
BUILDTRACK_BOOTSTRAP_ENABLED="no"
